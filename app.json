{
  "expo": {
    "name": "Daily Spark – Motivational Quotes & Daily Inspiration",
    "slug": "daily-spark",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dailyspark",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "dark": {
        "image": "./assets/images/splash-icon.png",
        "backgroundColor": "#0F1A2E"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dailyspark.quotes",
      "buildNumber": "3"
    },
    "android": {
      "package": "com.dailyspark.quotes",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#0F1A2E",
        "foregroundImage": "./assets/images/splash-icon.png"
      }
    },
    "web": {
      "favicon": "./assets/images/splash-icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1463796060515114~9395181817",
          "iosAppId": "ca-app-pub-1463796060515114~9395181817",
          "userTrackingUsageDescription": "This app uses ads to keep the app free. Your data is never sold."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://replit.com/"
      },
      "appVariant": "user",
      "eas": {
        "projectId": "48548b21-8946-4d4c-9c08-cdb35a78338a"
      }
    },
    "owner": "trrahat26"
  }
}
